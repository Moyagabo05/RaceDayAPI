@model RaceDayWeb.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Organiser Dashboard"; }
<h1 class="mb-4">Organiser Dashboard</h1>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card text-bg-primary"><div class="card-body"><h5>Total events created</h5><h2>@Model.TotalEvents</h2></div></div></div><div class="col-md-4"><div class="card text-bg-success"><div class="card-body"><h5>Total enrolments</h5><h2>@Model.TotalEnrolments</h2></div></div></div></div>
<div class="card"><div class="card-header">Upcoming events</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th></th></tr></thead><tbody>@foreach (var item in Model.UpcomingEvents){<tr><td>@item.Name</td><td>@item.EventDate.ToString("dd MMM yyyy HH:mm")</td><td>@item.EnrolmentCount</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Enrolments" asp-action="Details" asp-route-eventId="@item.EventID">View enrolments</a></td></tr>}</tbody></table></div></div>
