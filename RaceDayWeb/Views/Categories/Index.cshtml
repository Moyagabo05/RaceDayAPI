@model List<RaceDayWeb.ViewModels.CategoryViewModel>
@{
    ViewData["Title"] = "Event Categories";
    var eventId = (int)ViewBag.EventId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-uppercase text-muted mb-1">Organiser tools</p>
        <h1 class="mb-0">Event Categories</h1>
    </div>
    <a asp-action="Create" asp-route-eventId="@eventId" class="btn btn-primary">Add category</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card theme-card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">No categories have been added to this event yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Minimum age</th>
                            <th>Maximum age</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@(category.MinAge?.ToString() ?? "Any")</td>
                            <td>@(category.MaxAge?.ToString() ?? "Any")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<a asp-controller="Events" asp-action="Details" asp-route-id="@eventId" class="btn btn-link mt-3">Back to event</a>
