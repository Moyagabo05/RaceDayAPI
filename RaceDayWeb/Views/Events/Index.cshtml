@model List<RaceDayWeb.ViewModels.EventDisplayViewModel>

@{
    ViewData["Title"] = "Events";
    
    // Check who is logged in
    var userId = Context.Session.GetInt32("UserId");
    var role = Context.Session.GetString("UserRole");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@(role == "Organiser" ? "My Events" : "Browse Events")</h2>
    @if (role == "Organiser")
    {
        <a asp-action="Create" class="btn btn-primary">+ Create New Event</a>
    }
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No events found.</div>
}
else
{
    <div class="row">
        @foreach (var evt in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    @if (!string.IsNullOrEmpty(evt.BannerImageUrl))
                    {
                        <img src="@evt.BannerImageUrl" class="card-img-top" alt="Event Banner" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white" style="height: 200px;">No Image</div>
                    }
                    
                    <div class="card-body">
                        <h5 class="card-title">@evt.Name</h5>
                        <p class="card-text text-muted">@evt.EventType | @evt.Distance km</p>
                        <p class="card-text"><small class="text-muted">@evt.EventDate.ToString("dd MMM yyyy")</small></p>
                        <p class="card-text">@evt.Location</p>

                        <hr />
                        
                        @* BOTH ROLES CAN VIEW DETAILS *@
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@evt.EventID" class="btn btn-primary w-100 mb-2">View Details</a>
                        
                        @* ONLY ORGANISERS SEE EDIT/DELETE/CAPTURE *@
                        @if (role == "Organiser")
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="Events" asp-action="Edit" asp-route-id="@evt.EventID" class="btn btn-warning flex-grow-1">Edit</a>
                                <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@evt.EventID" class="btn btn-secondary flex-grow-1">Categories</a>
                                <a asp-controller="Results" asp-action="Capture" asp-route-eventId="@evt.EventID" class="btn btn-info flex-grow-1 text-white">Capture</a>
                                
                                <form asp-controller="Events" asp-action="Delete" asp-route-id="@evt.EventID" method="post" class="flex-grow-1" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                    <button type="submit" class="btn btn-danger w-100">Delete</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}