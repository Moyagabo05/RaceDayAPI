@model RaceDayWeb.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-uppercase text-muted mb-1">RaceDay account</p>
        <h1 class="mb-0">My Profile</h1>
    </div>
    <a asp-action="Edit" class="btn btn-primary">Edit profile</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card theme-card">
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
        {
            <img src="@Model.ProfilePictureUrl" alt="Profile picture" class="rounded-circle mb-4" style="width:140px;height:140px;object-fit:cover;" />
        }
        <div class="row g-4">
            <div class="col-md-6">
                <h2 class="h5">Personal information</h2>
                <dl class="row">
                    <dt class="col-sm-5">First name</dt><dd class="col-sm-7">@Model.FirstName</dd>
                    <dt class="col-sm-5">Last name</dt><dd class="col-sm-7">@Model.LastName</dd>
                    <dt class="col-sm-5">Date of birth</dt><dd class="col-sm-7">@(Model.DateOfBirth?.ToString("dd MMMM yyyy") ?? "Not provided")</dd>
                    <dt class="col-sm-5">Gender</dt><dd class="col-sm-7">@(Model.Gender ?? "Not provided")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h2 class="h5">Contact and club information</h2>
                <dl class="row">
                    <dt class="col-sm-5">Emergency contact</dt><dd class="col-sm-7">@(Model.EmergencyContact ?? "Not provided")</dd>
                    <dt class="col-sm-5">Club</dt><dd class="col-sm-7">@(Model.ClubName ?? "Not provided")</dd>
                    <dt class="col-sm-5">Organisation</dt><dd class="col-sm-7">@(Model.OrganisationName ?? "Not provided")</dd>
                    <dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@(Model.PhoneNumber ?? "Not provided")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
