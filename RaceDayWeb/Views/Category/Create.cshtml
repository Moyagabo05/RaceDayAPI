@model RaceDayWeb.ViewModels.CategoryEditViewModel
@{ ViewData["Title"] = "Add Category"; }
<h1>Add category</h1>
<form asp-action="Create" asp-route-eventId="@Model.EventId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="CategoryName" class="form-label"></label><input asp-for="CategoryName" class="form-control" /><span asp-validation-for="CategoryName" class="text-danger"></span></div>
    <div class="row"><div class="col"><label asp-for="MinAge" class="form-label"></label><input asp-for="MinAge" class="form-control" /></div><div class="col"><label asp-for="MaxAge" class="form-label"></label><input asp-for="MaxAge" class="form-control" /></div></div>
    <button class="btn btn-primary mt-3" type="submit">Save</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
