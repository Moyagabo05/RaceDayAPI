@model List<RaceDayWeb.ViewModels.MyResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<h2 class="mb-4">My Results</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">You don't have any recorded results yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td>@result.EventName</td>
                        <td>@result.CategoryName</td>
                        <td>@(result.FinishTime.HasValue ? result.FinishTime.Value.ToString(@"hh\:mm\:ss") : "Pending")</td>
                        <td>@(result.Position.HasValue ? $"#{result.Position}" : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}